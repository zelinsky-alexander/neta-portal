PORT=8080
HOST=0.0.0.0
NETA_COORDINATOR_URL=https://coordinator.example.internal:8443
NETA_COORDINATOR_REQUEST_TIMEOUT_MS=5000
NETA_COORDINATOR_ADMIN_TOKEN=
NETA_COORDINATOR_PORTAL_SERVICE_TOKEN=
NETA_PORTAL_SERVICE_NAME=neta-portal-prod
NETA_COORDINATOR_CA_FILE=/run/secrets/coordinator-ca.pem
NETA_COORDINATOR_CLIENT_CERT_FILE=/run/secrets/portal-client-cert.pem
NETA_COORDINATOR_CLIENT_KEY_FILE=/run/secrets/portal-client-key.pem
NETA_COORDINATOR_ALLOW_INSECURE_HTTP=false
NETA_PORTAL_LEGACY_OPERATOR_API=false

# Native Portal 0.3 authentication. Passwords are scrypt hashes, never plaintext.
# Generate a hash with Node.js using server/auth.ts/hashPassword or the README command.
NETA_PORTAL_USERS_JSON=[]
NETA_PORTAL_SESSION_SECRET=
NETA_PORTAL_SESSION_TTL_SECONDS=28800
