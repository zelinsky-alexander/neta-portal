{
  "name": "neta-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch server/server.ts\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/server.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.0",
    "@fastify/static": "^8.0.0",
    "@tanstack/react-query": "^5.0.0",
    "fastify": "^5.0.0",
    "tsx": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
